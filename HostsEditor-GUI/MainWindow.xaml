<Window x:Class="HostsEditor_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:HostsEditor_GUI.Models"
        mc:Ignorable="d"
        Title="Hosts 编辑器" Height="600" Width="900"
        MinHeight="400" MinWidth="640"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Window.Foreground}">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Status.Background}"
                Padding="8,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Separator.Border}">
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedThemeOption}"
                          Style="{DynamicResource ComboBoxStyle}"
                          ItemContainerStyle="{DynamicResource ComboBoxItemStyle}"
                          DisplayMemberPath="Name" Width="120" Margin="8,0,0,0"
                          VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="刷新" Style="{DynamicResource DefaultButton}" Command="{Binding RefreshCommand}" />
                    <Button Content="添加" Style="{DynamicResource AccentButton}" Command="{Binding AddCommand}" Margin="6,0,0,0" />
                    <Button Content="启用" Style="{DynamicResource DefaultButton}" Command="{Binding EnableSelectedCommand}" Margin="6,0,0,0" />
                    <Button Content="禁用" Style="{DynamicResource DefaultButton}" Command="{Binding DisableSelectedCommand}" Margin="6,0,0,0" />
                    <Button Content="移动到" Style="{DynamicResource DefaultButton}" Command="{Binding MoveSelectedCommand}" Margin="6,0,0,0" />
                    <Button Content="删除" Style="{DynamicResource DefaultButton}" Command="{Binding RemoveSelectedCommand}" Margin="6,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Status.Background}"
                Padding="8,5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Separator.Border}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="文件:" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="{DynamicResource Brush.Control.Disabled.Foreground}" />
                <TextBox DockPanel.Dock="Left" Text="{Binding HostsFilePath, UpdateSourceTrigger=LostFocus}"
                         Style="{DynamicResource TextBoxStyle}" Width="360" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 主体分组树 -->
        <TreeView ItemsSource="{Binding Groups}" Padding="4"
                  SelectedItemChanged="OnTreeViewSelectedItemChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type models:HostGroup}" ItemsSource="{Binding Entries}">
                    <Border Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            Padding="2,2">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="启用分组"
                                          Command="{Binding PlacementTarget.Tag.EnableTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="禁用分组"
                                          Command="{Binding PlacementTarget.Tag.DisableTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="添加条目..."
                                          Command="{Binding PlacementTarget.Tag.AddToGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Header.Foreground}" />
                            <TextBlock Text="{Binding Entries.Count, StringFormat=({0})}"
                                       Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Control.Disabled.Foreground}" />
                        </StackPanel>
                    </Border>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type models:HostEntry}">
                    <StackPanel x:Name="Row" Orientation="Horizontal"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="启用"
                                          Command="{Binding PlacementTarget.Tag.EnableTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="禁用"
                                          Command="{Binding PlacementTarget.Tag.DisableTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="移动到分组..."
                                          Command="{Binding PlacementTarget.Tag.MoveTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="删除"
                                          Command="{Binding PlacementTarget.Tag.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="OnEntryCheckBoxClicked"
                                  VerticalAlignment="Center" Margin="2,0,8,0"
                                  ToolTip="切换启用/禁用" />
                        <TextBlock x:Name="IpText" Text="{Binding Ip}" Margin="0,0,12,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Window.Foreground}" />
                        <TextBlock x:Name="HostText" Text="{Binding HostName}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Window.Foreground}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</Window>
