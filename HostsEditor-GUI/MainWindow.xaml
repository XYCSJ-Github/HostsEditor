<Window x:Class="HostsEditor_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:HostsEditor_GUI.Models"
        mc:Ignorable="d"
        Title="Hosts 编辑器" Height="600" Width="900"
        Icon="pack://application:,,,/icon.ico"
        MinHeight="400" MinWidth="640">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Padding="8,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="刷新" Command="{Binding RefreshCommand}" />
                <Button Content="添加" Command="{Binding AddCommand}" Margin="6,0,0,0" />
                <Button Content="编辑" Command="{Binding EditSelectedCommand}" Margin="6,0,0,0"
                        ToolTip="编辑选中的条目（仅单选）" />
                <Button Content="启用" Command="{Binding EnableSelectedCommand}" Margin="6,0,0,0"
                        ToolTip="启用全部选中项（支持多选）" />
                <Button Content="禁用" Command="{Binding DisableSelectedCommand}" Margin="6,0,0,0"
                        ToolTip="禁用全部选中项（支持多选）" />
                <Button Content="移动到" Command="{Binding MoveSelectedCommand}" Margin="6,0,0,0"
                        ToolTip="移动全部选中条目到其他分组" />
                <Button Content="删除" Command="{Binding RemoveSelectedCommand}" Margin="6,0,0,0"
                        ToolTip="删除全部选中条目" />
                <Separator Margin="6,0,6,0" />
                <Button Content="打开文件" Command="{Binding OpenFileCommand}"
                        ToolTip="用记事本打开 hosts 文件" />
                <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}" Margin="6,0,0,0"
                        ToolTip="在资源管理器中定位 hosts 文件" />
            </StackPanel>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Padding="8,5" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="文件:" VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBox DockPanel.Dock="Left" Text="{Binding HostsFilePath, UpdateSourceTrigger=LostFocus}"
                         Width="360" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 主体分组树：勾选复选框表示选择，可多选 -->
        <TreeView ItemsSource="{Binding Groups}" Padding="4"
                  PreviewMouseLeftButtonDown="OnTreeViewPreviewMouseLeftButtonDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <!-- 选择由复选框表达，去掉 TreeView 自带选中蓝底 -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{x:Static SystemColors.ControlTextColor}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{x:Static SystemColors.ControlTextColor}" />
                <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="Transparent" />
                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="Transparent" />
                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="{x:Static SystemColors.ControlTextColor}" />
                <HierarchicalDataTemplate DataType="{x:Type models:HostGroup}" ItemsSource="{Binding Entries}">
                    <Border Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            Padding="2,2">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="启用分组"
                                          Command="{Binding PlacementTarget.Tag.EnableTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="禁用分组"
                                          Command="{Binding PlacementTarget.Tag.DisableTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="添加条目..."
                                          Command="{Binding PlacementTarget.Tag.AddToGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Click="OnSelectionCheckBoxClick"
                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                      ToolTip="选择/取消选择整组（组内条目一并选中/取消）" />
                            <TextBlock x:Name="GroupNameText" Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Entries.Count, StringFormat=({0})}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding AllDisabled}" Value="True">
                            <Setter TargetName="GroupNameText" Property="TextDecorations" Value="Strikethrough" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type models:HostEntry}">
                    <StackPanel x:Name="Row" Orientation="Horizontal"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑..."
                                          Command="{Binding PlacementTarget.Tag.EditTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="启用"
                                          Command="{Binding PlacementTarget.Tag.EnableTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="禁用"
                                          Command="{Binding PlacementTarget.Tag.DisableTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="移动到分组..."
                                          Command="{Binding PlacementTarget.Tag.MoveTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="删除"
                                          Command="{Binding PlacementTarget.Tag.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Click="OnSelectionCheckBoxClick"
                                  VerticalAlignment="Center" Margin="2,0,8,0"
                                  ToolTip="选择/取消选择（可多选，按住 Shift 连选）" />
                        <TextBlock x:Name="IpText" Text="{Binding Ip}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="HostText" Text="{Binding HostName}" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter TargetName="IpText" Property="Opacity" Value="0.5" />
                            <Setter TargetName="HostText" Property="Opacity" Value="0.5" />
                            <Setter TargetName="IpText" Property="TextDecorations" Value="Strikethrough" />
                            <Setter TargetName="HostText" Property="TextDecorations" Value="Strikethrough" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</Window>
