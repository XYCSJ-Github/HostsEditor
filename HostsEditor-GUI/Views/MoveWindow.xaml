<Window x:Class="HostsEditor_GUI.Views.MoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="移动到分组" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Window.Foreground}">
    <StackPanel Margin="16">
        <TextBlock Text="目标分组" />
        <ComboBox x:Name="GroupBox" Style="{DynamicResource ComboBoxStyle}"
                  ItemContainerStyle="{DynamicResource ComboBoxItemStyle}" Margin="0,4,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Style="{DynamicResource AccentButton}" Click="OnOk" IsDefault="True" />
            <Button Content="取消" Style="{DynamicResource DefaultButton}" Click="OnCancel" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
