<Window x:Class="HostsEditor_GUI.Views.EditEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑条目" Width="360" SizeToContent="Height"
        Icon="pack://application:,,,/icon.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="IP 地址" />
        <TextBox x:Name="IpBox" Margin="0,4,0,12" />
        <TextBlock Text="主机名" />
        <TextBox x:Name="HostBox" Margin="0,4,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Click="OnOk" IsDefault="True" />
            <Button Content="取消" Click="OnCancel" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
