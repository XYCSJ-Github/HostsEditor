  <Target Name="EnsureGuiPublish"
          Inputs="@(_GuiSources)"
          Outputs="$(PublishDir)HostsEditor-GUI.exe">
    <MSBuild Projects="$(GuiProject)"
             Targets="Restore"
             Properties="Configuration=Release;Platform=Any CPU;RuntimeIdentifier=win-x64;SelfContained=true" />
    <MSBuild Projects="$(GuiProject)"
             Targets="Publish"
             Properties="Configuration=Release;Platform=Any CPU;RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishReadyToRun=true;PublishDir=$(PublishDir)" />
  </Target>

  <Target Name="GenerateEmbeddedResources"
          DependsOnTargets="EnsureGuiPublish"
          Inputs="$(PublishDir)HostsEditor-GUI.exe;$(PublishDir)HostsEditor-Cmd.exe"
          Outputs="$(EmbeddedRcFile)"
          BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_PublishFiles Include="$(PublishDir)*" Exclude="$(PublishDir)*.pdb" />
    </ItemGroup>
    <PropertyGroup>
      <_PublishDirFwd>$([System.String]::Copy('$(PublishDir)').Replace('\', '/'))</_PublishDirFwd>
    </PropertyGroup>
    <ItemGroup>
      <_RcLines Include="@(_PublishFiles->'&quot;%(Filename)%(Extension)&quot; RCDATA &quot;$(_PublishDirFwd)%(Filename)%(Extension)&quot;')" />
    </ItemGroup>
    <WriteLinesToFile File="$(EmbeddedRcFile)" Lines="@(_RcLines)" Overwrite="true" />
  </Target>

